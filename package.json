{
  "name": "orbix-agent",
  "version": "3.2.0",
  "description": "ORBIX - a local-first AI coding workspace in your browser. Asks before it edits or runs anything; every change can be undone.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "bin": {
    "orbix": "src/main.mjs",
    "orbix-agent": "src/main.mjs"
  },
  "files": [
    "src/",
    "web/",
    "assets/icon.png",
    "assets/icon.ico",
    "tools/doctor.mjs",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test",
    "serve": "node src/main.mjs --serve",
    "doctor": "node tools/doctor.mjs"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "agent",
    "web-app",
    "local-first",
    "wsl",
    "claude",
    "chatgpt",
    "openrouter",
    "ollama"
  ],
  "author": "chsxthwik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chsxthwik/ORBIX.git"
  },
  "bugs": {
    "url": "https://github.com/chsxthwik/ORBIX/issues"
  },
  "homepage": "https://orbix-agent.vercel.app"
}
