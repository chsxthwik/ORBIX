{
  "name": "orbix-agent",
  "version": "3.2.0",
  "description": "ORBIX - a local-first AI coding workspace for Windows. Asks before it edits or runs anything; every change can be undone.",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "shots": "node tools/shots.mjs"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "agent",
    "local-first",
    "wsl",
    "claude",
    "chatgpt",
    "openrouter",
    "ollama",
    "windows",
    "desktop-app"
  ],
  "author": "chsxthwik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chsxthwik/ORBIX.git"
  },
  "bugs": {
    "url": "https://github.com/chsxthwik/ORBIX/issues"
  },
  "homepage": "https://orbix-agent.vercel.app",
  "productName": "ORBIX",
  "build": {
    "appId": "com.comx.orbix",
    "productName": "ORBIX",
    "copyright": "Copyright © 2026 COM-X Corporation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "web/**",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "chsxthwik",
        "repo": "ORBIX",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "ORBIX"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORBIX",
      "uninstallDisplayName": "ORBIX",
      "artifactName": "ORBIX-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
