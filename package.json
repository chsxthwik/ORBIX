{
  "name": "orbix-agent",
  "version": "4.0.0",
  "description": "ORBIX: the unified open-source agentic development environment. Every agent, every model, one workspace that asks before it acts.",
  "type": "module",
  "main": "electron/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "e2e": "node e2e/run.mjs && node e2e/conversation.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always",
    "shots": "node tools/shots.mjs",
    "server": "node src/headless.mjs"
  },
  "keywords": [
    "ade",
    "agentic-development-environment",
    "coding-agent",
    "ai-agent",
    "llm",
    "acp",
    "mcp",
    "local-first",
    "self-hosted",
    "wsl",
    "windows",
    "desktop-app",
    "open-source"
  ],
  "author": "QUANTUM (COM-X Innovations, Inc.)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chsxthwik/ORBIX.git"
  },
  "bugs": {
    "url": "https://github.com/chsxthwik/ORBIX/issues"
  },
  "homepage": "https://orbix-agent.vercel.app",
  "productName": "ORBIX",
  "build": {
    "appId": "com.comx.orbix",
    "productName": "ORBIX",
    "copyright": "Copyright © 2026 QUANTUM, COM-X Innovations, Inc.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "web/**",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "chsxthwik",
        "repo": "ORBIX",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "ORBIX"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORBIX",
      "uninstallDisplayName": "ORBIX",
      "artifactName": "ORBIX-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "bin": {
    "orbix-server": "src/headless.mjs"
  }
}
