+        h('span', { class: 'sched-sep' }, '·'),
+        lastLine(s, ctx))),
+    h('div', { class: 'sched-acts' },
+      btn('Run now', async () => {
+        const j = await post('/api/schedule/run', { id: s.id }).catch(() => null);
+        if (!j) return;
+        items.set(s.id, j.schedule);
