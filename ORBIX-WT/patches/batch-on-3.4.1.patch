+      h('span', null, h('b', null, title), h('span', { class: 'muted small' }, text)));
+
+  function recurrence() {
+    if (kind === 'daily' || kind === 'weekdays') return { kind, time: time.value };
+    if (kind === 'every') {
+      const n = Number(count.value);
+      return { kind, minutes: unit.value === 'h' ? n * 60 : n };
+    }
