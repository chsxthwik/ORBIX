+        redraw();
+      }, 'sm'),
+      btn('Delete', async () => {
+        if (!(await confirmDialog('Delete this schedule?', `"${s.title}" will not run again. Runs it already started stay in Runs.`, { ok: 'Delete', danger: true }))) return;
