+/* Scheduled runs (web/js/schedules.js): the Scheduled section of the Runs view and the dialog that makes one.
+   Uses the tokens of app.css and the run classes of runs.css only. */
+.sched-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
+.sched-head h2 { margin: 0; }
+.sched-row { display: flex; align-items: center; gap: 14px; width: 100%; padding: 11px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-raise); }
+.sched-row.off .sched-main { opacity: .62; }
+.sched-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
+.sched-status { flex-wrap: wrap; white-space: normal; }
+.sched-status b { font-weight: 550; color: var(--fg-2); }
+.sched-sep { color: var(--fg-4, var(--fg-3)); }
+.sched-last { display: inline-flex; align-items: center; gap: 4px; padding: 0; color: var(--fg-3); font-size: 12.5px; text-align: left; }
+.sched-last:not(:disabled):hover { color: var(--fg); }
+.sched-last .run-pill { height: 20px; padding: 0 8px; font-size: 12px; }
+.sched-err { display: inline-flex; align-items: center; gap: 4px; color: var(--err); }
+.sched-acts { display: flex; align-items: center; gap: 6px; flex: none; }
+.run-sched { display: inline-flex; align-items: center; gap: 4px; color: var(--fg-2); }
+.run-sched + svg { margin-left: 6px; }
+
+/* The dialog */
+.sched-form textarea { width: 100%; min-height: 70px; background: var(--bg-field); }
+.sched-form select { max-width: 100%; height: 34px; }
+.sched-when { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.sched-when > select { width: auto; min-width: 190px; }
+.sched-when-in { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; }
+.sched-when-in select { width: auto; }
+/* app.css styles text fields only; these match them */
+.sched-when-in input { height: 34px; padding: 0 10px; border: 1px solid var(--line-3); border-radius: var(--r); background: var(--bg-field); color: var(--fg); font-size: 14px; color-scheme: inherit; }
+.sched-when-in input[type="number"] { width: 76px; }
+
+@media (max-width: 640px) {
+  .sched-row { flex-wrap: wrap; }
+  .sched-acts { width: 100%; justify-content: flex-end; }
+}
