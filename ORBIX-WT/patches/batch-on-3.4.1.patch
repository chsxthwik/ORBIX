+ */
+export function schedulesSection(ctx) {
+  if (!loaded && !loading && !loadError) load();
+  const list = [...items.values()].sort((a, b) => (a.enabled === b.enabled ? (a.nextAt ?? Infinity) - (b.nextAt ?? Infinity) : a.enabled ? -1 : 1));
