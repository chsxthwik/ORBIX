+      h('span', { class: 'grow' }),
+      btn('New schedule…', () => newScheduleDialog(), 'sm')),
+    loadError ? h('p', { class: 'sched-err small' }, `Could not load schedules: ${loadError} `, btn('Retry', () => ((loadError = ''), load()), 'ghost sm')) :
