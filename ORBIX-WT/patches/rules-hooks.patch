+    put(path.join(ws, '.agents', 'rules', 'py.md'), '---\ntrigger: glob\nglobs: "*.py"\n---\nx');
+    put(path.join(ws, '.agents', 'rules', 'bad.md'), '---\ntrigger: sometimes\n---\nx');
+    const out = [];
