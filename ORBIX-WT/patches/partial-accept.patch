+    put(repo, 'a.txt', 'a\n');
+    put(repo, 'b.txt', 'b\n');
+    put(repo, 'c.txt', 'c\n');
+    put(repo, 'long.txt', LONG);
+    put(repo, 'notes.txt', 'mine\n');
+    g(repo, 'add', '-A');
+    g(repo, 'commit', '-qm', 'start');
