+    assert.equal(s.title, 'Run the tests');
+    assert.equal(s.nextAt, local(2026, 11, 20, 9, 0));
+    assert.deepEqual(s.scope, { edits: true, commands: true });
+    const raw = JSON.parse(fs.readFileSync(file, 'utf8'));
